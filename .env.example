# ==========================================
# Meeting Room Management System - Environment Variables
# ==========================================

# 1. PostgreSQL Database URL (Required)
# Local PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/meeting_room_db?schema=public"

# Cloud PostgreSQL (Neon / Supabase / Railway / Render):
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. JWT Authentication Secret Key (Required)
# Generate a secure 32+ character random string for production
AUTH_SECRET="change-this-to-a-secure-random-secret-key"

# 3. Application Public URL (Optional / Production)
# e.g., https://meeting-room-system.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
